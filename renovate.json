{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "local>jamesread/jwr-soe-ansible//renovate/ansible-images"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "Image and version bumps in role defaults are fixes for users of the collection",
      "matchManagers": ["custom.regex"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    }
  ]
}
