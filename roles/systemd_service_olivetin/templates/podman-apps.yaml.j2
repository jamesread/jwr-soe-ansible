# {{ ansible_managed }}
# Generated by systemd_service_olivetin from the podman_app apps on this host.
{% set apps = podman_app_apps | default([]) | sort(attribute='name') %}
actions:
{% for app in apps %}
{% set systemctl = 'systemctl --user -M ' ~ app.run_user ~ '@' if app.rootless else 'systemctl' %}
{% set podman = 'runuser -u ' ~ app.run_user ~ ' -- env XDG_RUNTIME_DIR=/run/user/' ~ app.run_uid ~ ' podman' if app.rootless else 'podman' %}
  - title: Start {{ app.name }}
    id: podman-app-{{ app.name }}-start
    icon: '<iconify-icon icon="material-symbols:play-arrow-rounded"></iconify-icon>'
    shell: {{ (systemctl ~ ' start ' ~ app.name) | to_json }}

  - title: Stop {{ app.name }}
    id: podman-app-{{ app.name }}-stop
    icon: '<iconify-icon icon="material-symbols:stop"></iconify-icon>'
    shell: {{ (systemctl ~ ' stop ' ~ app.name) | to_json }}

  - title: Restart {{ app.name }}
    id: podman-app-{{ app.name }}-restart
    icon: '<iconify-icon icon="material-symbols:restart-alt"></iconify-icon>'
    shell: {{ (systemctl ~ ' restart ' ~ app.name) | to_json }}

  # Pulls the image's tag again, and restarts onto it (recreating the container).
  - title: Update {{ app.name }}
    id: podman-app-{{ app.name }}-update
    icon: '<iconify-icon icon="material-symbols:upgrade"></iconify-icon>'
    timeout: 600
    shell: {{ (podman ~ ' pull ' ~ app.image ~ ' && ' ~ systemctl ~ ' restart ' ~ app.name) | to_json }}

{% endfor %}
dashboards:
  - title: Podman apps
    contents:
{% for app in apps %}
      - title: {{ app.name | to_json }}
        type: fieldset
        contents:
{% for verb in ['Start', 'Stop', 'Restart', 'Update'] %}
          - title: {{ (verb ~ ' ' ~ app.name) | to_json }}
{% endfor %}
{% endfor %}
