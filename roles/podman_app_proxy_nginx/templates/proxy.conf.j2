# {{ ansible_managed }}
# Generated by podman_app_proxy_nginx.
{% set tls = podman_app_proxy_nginx_tls_active | bool %}
{% set certbot = podman_app_proxy_nginx_certbot | bool %}
{% set ipv6 = podman_app_proxy_nginx_ipv6 | bool %}
{% macro listen(port, extra='') %}
    listen {{ port }}{{ extra }};
{% if ipv6 %}
    listen [::]:{{ port }}{{ extra }};
{% endif %}
{% endmacro %}
{% macro acme() %}
{% if certbot %}
    # Let's Encrypt http-01 challenges, answered by certbot while it runs.
    location /.well-known/acme-challenge/ {
        proxy_pass http://127.0.0.1:{{ podman_app_proxy_nginx_certbot_http_port }};
    }
{% endif %}
{% endmacro %}
{% macro proxy(vhost) %}
    location / {
        proxy_pass {{ vhost.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{% if vhost.extra is defined %}
        {{ vhost.extra | indent(8) }}
{% endif %}
    }
{% endmacro %}
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server_tokens off;
client_max_body_size {{ podman_app_proxy_nginx_client_max_body_size }};
# Websockets and other long-lived connections.
proxy_read_timeout 1h;
proxy_send_timeout 1h;
{% if podman_app_proxy_nginx_default_server | bool %}

# Requests for hostnames with no vhost are turned away.
server {
{{ listen(80, ' default_server') -}}
{{ acme() -}}
    location / {
        return 444;
    }
}
{% if tls %}

server {
{{ listen(443, ' ssl default_server') -}}
    ssl_reject_handshake on;
}
{% endif %}
{% endif %}
{% for vhost in podman_app_proxy_nginx_all_vhosts %}
{% set vhost_tls = tls and vhost.tls | default(true) | bool %}

server {
{{ listen(80) -}}
    server_name {{ vhost.server_name }};
{{ acme() -}}
{% if vhost_tls %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
{{ proxy(vhost) -}}
{% endif %}
}
{% if vhost_tls %}

server {
{{ listen(443, ' ssl') -}}
    http2 on;
    server_name {{ vhost.server_name }};
    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
{{ proxy(vhost) -}}
}
{% endif %}
{% endfor %}
{% if podman_app_proxy_nginx_extra_conf | length > 0 %}

{{ podman_app_proxy_nginx_extra_conf }}
{% endif %}
