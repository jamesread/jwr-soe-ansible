# {{ ansible_managed }}
# Generated by systemd_service_proxy_haproxy.
{% set certbot = systemd_service_proxy_haproxy_certbot | bool %}
{% set tls = systemd_service_proxy_haproxy_tls_active | bool %}
{% set vhosts = systemd_service_proxy_haproxy_all_vhosts %}
{% macro backend_name(vhost) %}be_{{ vhost.server_name | regex_replace('[^A-Za-z0-9_.-]', '_') }}{% endmacro %}
{% macro routes(only_tls) %}
{% for vhost in vhosts if (not only_tls or vhost.tls | default(true) | bool) %}
    use_backend {{ backend_name(vhost) }} if { req.hdr(host),field(1,:) -i {{ vhost.server_name }} }
{% endfor %}
{% endmacro %}
global
    log /dev/log local0
    chroot /var/lib/haproxy
    pidfile /var/run/haproxy.pid
    user haproxy
    group haproxy
    daemon
    stats socket /var/lib/haproxy/stats
    ssl-default-bind-options ssl-min-ver TLSv1.2

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option forwardfor
    timeout connect 5s
    timeout client 60s
    timeout server 60s
    # Websockets and other upgraded connections.
    timeout tunnel 1h

frontend http
    bind :80
{% if certbot %}
    # Let's Encrypt http-01 challenges, answered by certbot while it runs.
    acl acme path_beg /.well-known/acme-challenge/
    use_backend acme if acme
{% endif %}
{% if tls %}
{% set http_only = vhosts | rejectattr('tls', 'undefined') | rejectattr('tls') | map(attribute='server_name') | list %}
{% set conditions = (['!acme'] if certbot else []) + (['!{ req.hdr(host),field(1,:) -i ' ~ (http_only | join(' ')) ~ ' }'] if http_only | length > 0 else []) %}
    http-request redirect scheme https code 301{{ (' if ' ~ conditions | join(' ')) if conditions | length > 0 }}
{% for vhost in vhosts if not vhost.tls | default(true) | bool %}
    use_backend {{ backend_name(vhost) }} if { req.hdr(host),field(1,:) -i {{ vhost.server_name }} }
{% endfor %}
{% else %}
{{ routes(false) -}}
{% endif %}
{% if tls %}

frontend https
    bind :443 ssl crt {{ systemd_service_proxy_haproxy_pem }} alpn h2,http/1.1
    http-request set-header X-Forwarded-Proto https
{{ routes(true) -}}
{% endif %}
{% for vhost in vhosts %}

backend {{ backend_name(vhost) }}
    server app {{ vhost.upstream | urlsplit('hostname') }}:{{ vhost.upstream | urlsplit('port') | default(443 if vhost.upstream.startswith('https') else 80, true) }} check{{ ' ssl verify none' if vhost.upstream.startswith('https') }}
{% endfor %}
{% if certbot %}

backend acme
    server certbot 127.0.0.1:{{ systemd_service_proxy_haproxy_certbot_http_port }}
{% endif %}
{% if systemd_service_proxy_haproxy_stats_bind | length > 0 %}

frontend stats
    bind {{ systemd_service_proxy_haproxy_stats_bind }}
    http-request use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri /stats
{% endif %}
