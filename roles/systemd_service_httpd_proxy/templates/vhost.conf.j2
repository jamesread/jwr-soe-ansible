<VirtualHost *:80>
    ServerName {{ item.server_name }}

    ProxyPreserveHost On
    ProxyPass / {{ item.upstream }}
    ProxyPassReverse / {{ item.upstream }}

    ErrorLog {{ systemd_service_httpd_proxy_log_dir }}/{{ item.server_name }}-error.log
    CustomLog {{ systemd_service_httpd_proxy_log_dir }}/{{ item.server_name }}-access.log combined
</VirtualHost>
